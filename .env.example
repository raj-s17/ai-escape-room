# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it is listed in .gitignore).

# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use. "gemini-flash-latest" always points
# to the current free Flash model; you can pin a specific one instead.
GEMINI_MODEL=gemini-flash-latest
