# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it is listed in .gitignore).

# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use. If this model is not available for
# your key, the app automatically picks the newest available Flash model.
# See https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-2.5-flash
